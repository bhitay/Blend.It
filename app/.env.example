# Copy to .env and fill in from Supabase → Project Settings → API (Data API / API Keys).
# The publishable (anon) key is safe to ship in the app; data is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
